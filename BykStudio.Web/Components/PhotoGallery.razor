@code {
    [Parameter] public List<string> Photos { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private int CurrentIndex = 0;

    private void Prev() => CurrentIndex = (CurrentIndex - 1 + Photos.Count) % Photos.Count;
    private void Next() => CurrentIndex = (CurrentIndex + 1) % Photos.Count;
    private void GoTo(int index) => CurrentIndex = index;
}

<div class="fixed inset-0 bg-black/95 z-50 flex items-center justify-center p-6">
    <button @onclick="OnClose"
            class="absolute top-8 right-8 text-white text-4xl hover:scale-125 transition-all">
        ✕
    </button>

    <!-- Main image -->
    <div class="relative max-w-5xl w-full">
        <img src="@Photos[CurrentIndex]"
             class="max-h-[80vh] w-auto mx-auto rounded-3xl shadow-2xl object-contain" />

        <!-- Arrows -->
        <button @onclick="Prev"
                class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-14 h-14 rounded-full flex items-center justify-center text-3xl transition-all">
            ←
        </button>
        <button @onclick="Next"
                class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-14 h-14 rounded-full flex items-center justify-center text-3xl transition-all">
            →
        </button>
    </div>

    <!-- Thumbnails -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-4 bg-black/50 p-4 rounded-3xl">
        @foreach (var (photo, i) in Photos.Select((p, i) => (p, i)))
        {
            <img src="@photo"
                 @onclick="() => GoTo(i)"
                 class="w-20 h-20 object-cover rounded-2xl cursor-pointer transition-all border-4 @(i == CurrentIndex ? "border-white scale-110" : "border-transparent")" />
        }
    </div>
</div>