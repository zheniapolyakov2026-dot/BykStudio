@page "/makeup-booking"
@layout FullScreenLayout
@rendermode InteractiveServer
@using BykStudio.data.DTOs
@using BykStudio.Web.Services
@inject MakeupTableService MakeupTableService
@inject NavigationManager NavigationManager

<div class="page-container" style="position: relative; height: 100vh; width: 100%; overflow: hidden;">

    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Makeup Studio" />

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.07; z-index: 2;"></div>

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.18), rgba(0,0,0,0.65));
    z-index: 3;"></div>

    <div class="hover-dark-overlay"></div>

    <div style="position: relative; z-index: 4; height: 100vh;
        display: flex; flex-direction: column; justify-content: center; align-items: center;
        padding: 0 20px;">

        <!-- Кнопка "Назад" теперь прямо в контейнере (как в Rooms.razor) -->
        <button @onclick="GoBack" class="back-button">
            Назад
        </button>

        <h1 style="color: #ffffff;
            font-size: clamp(39px, 7.1vw, 84px);
            font-weight: 900;
            letter-spacing: clamp(-3px, -0.6vw, -5.5px);
            text-shadow: 0 18px 55px rgba(0,0,0,0.9);
            margin-bottom: clamp(32px, 5.8vh, 68px);">
            Гримерный стол
        </h1>

        <div style="display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 515px));
            gap: clamp(28px, 4.6vw, 78px);
            width: 100%;
            max-width: 1700px;
            justify-content: center;">

            @foreach (var table in TableList)
            {
                <div class="glass-card">
                    <img src="@table.MainImageUrl"
                         style="width: 100%; height: clamp(245px, 31.5vh, 415px); object-fit: cover;"
                         alt="@table.Name" />
                    <div style="padding: clamp(30px, 4vw, 46px) clamp(26px, 3.6vw, 46px) clamp(36px, 4.5vw, 50px);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                            <h2 style="color: white; font-size: clamp(28px, 4.7vw, 41px); font-weight: 800; margin: 0;">
                                @table.Name
                            </h2>
                            <span style="color: #e0c070; font-size: clamp(20px, 3vw, 28px); font-weight: 700;">
                                @table.PricePerHour ₽/час
                            </span>
                        </div>
                        <p style="color: rgba(255,255,255,0.95);
                                      line-height: 1.6;
                                      margin-bottom: 24px;
                                      font-size: clamp(15.5px, 2.4vw, 18.5px);">
                            @table.Description
                        </p>
                        <button @onclick="GoToCalendar" class="btn-primary">Забронировать</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .page-container {
        position: relative;
    }

    .hover-dark-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.93));
        z-index: 3.5;
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
    }

    .page-container:hover .hover-dark-overlay {
        opacity: 1;
    }

    .glass-card {
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(24px);
        border-radius: clamp(26px, 3.4vw, 42px);
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 35px 90px rgba(0,0,0,0.75);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .glass-card:hover {
            transform: translateY(-12px);
            border-color: #e0c070;
            box-shadow: 0 45px 100px rgba(224,192,112,0.35);
        }

    .btn-primary {
        .btn-primary {
            width: 100%;
            padding: clamp(16px, 2.8vw, 25px) clamp(24px, 4vw, 40px); /* ← увеличили горизонтальный padding */
            font-size: clamp(17px, 2.8vw, 22.5px);
            font-weight: 700;
            background: white;
            color: #111;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            transition: all 0.3s ease;
            white-space: nowrap; /* ← текст не переносится */
            overflow: hidden; /* ← если всё же вылезет — обрежется */
            text-overflow: ellipsis; /* ← … в конце, если не помещается */
        }
    }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        }

    /* Добавил стили для кнопки "Назад" — теперь она красиво в левом верхнем углу */
    .back-button {
        position: absolute;
        top: 30px;
        left: 30px;
        padding: 12px 24px;
        font-size: 18px;
        font-weight: 700;
        color: white;
        background: rgba(0,0,0,0.4);
        border: 2px solid rgba(255,255,255,0.6);
        border-radius: 50px;
        backdrop-filter: blur(12px);
        z-index: 10;
        transition: all 0.3s ease;
    }

        .back-button:hover {
            background: #e0c070;
            color: #111;
            border-color: #e0c070;
        }
</style>

@code {
    private void GoBack() => NavigationManager.NavigateTo("/booking-selection");

    private List<MakeupTableDto> TableList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tables = await MakeupTableService.GetAllMakeupTablesAsync();
            if (tables != null)
            {
                TableList = tables;
            }
        }
        catch (Exception ex)
        {
            // Log error (optional)
            Console.WriteLine($"Error loading makeup tables: {ex}");
        }
    }

    private void GoToCalendar() => NavigationManager.NavigateTo("/makeup-calendar");
}