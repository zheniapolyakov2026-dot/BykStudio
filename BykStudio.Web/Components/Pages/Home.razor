@page "/"
@layout FullScreenLayout
@rendermode InteractiveServer        
@inject NavigationManager NavigationManager

<div style="position: relative; height: 100vh; width: 100%; overflow: hidden;">
    <!-- Фон -->
    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio" />

    <!-- Белый оверлей -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.2; z-index: 2;"></div>

    <!-- Контент -->
    <div style="position: relative; z-index: 3; height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 20px;">
        <div>
            <h1 style="font-size: clamp(85px, 16.5vw, 295px);
                       font-weight: 900;
                       letter-spacing: -0.045em;
                       line-height: 0.82;
                       margin: 0;
                       transform: translateY(-19vh);
                       color: #ffffff;
                       -webkit-text-stroke: 1px #e0c070;
                       text-shadow: 0 0 10px rgba(224,192,112,0.45), 0 15px 45px rgba(0,0,0,0.5);
                       opacity: 0.72;">
                BykStudio
            </h1>

            <button @onclick="GoToRooms"
                    style="margin-top: clamp(40px, 7vh, 95px);
                           padding: clamp(15px, 2.6vw, 21px) clamp(52px, 6.8vw, 88px);
                           font-size: clamp(17.5px, 2.6vw, 25px);
                           font-weight: 600;
                           border: clamp(3px, 0.4vw, 4.5px) solid white;
                           color: white;
                           border-radius: 50px;
                           background: transparent;
                           cursor: pointer;
                           box-shadow: 0 10px 32px rgba(0,0,0,0.35);
                           transition: all 0.3s ease;">
                Забронировать
            </button>
        </div>
    </div>
</div>

@code {
    private void GoToRooms()
    {
        NavigationManager.NavigateTo("/rooms");
    }
    private void GoToCalendar()
    {
        NavigationManager.NavigateTo("/calendar");
    }
}