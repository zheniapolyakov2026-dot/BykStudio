@page "/profile"
@rendermode InteractiveServer
@layout FullScreenLayout
@using BykStudio.data.DTOs
@using BykStudio.Web.Services
@inject AuthService AuthService
@inject ProfileApiClient ProfileApiClient
@inject NavigationManager NavigationManager

<div class="page-container" style="position: relative; height: 100vh; width: 100%; overflow: hidden;">

    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Background" />

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.07; z-index: 2;"></div>

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.18), rgba(0,0,0,0.65));
                z-index: 3;"></div>

    <div class="hover-dark-overlay"></div>

    <div style="position: relative; z-index: 4; height: 100vh;
                display: flex; flex-direction: column; justify-content: flex-start; align-items: center;
                padding: clamp(60px, 8vh, 100px) 20px 40px; overflow-y: auto;">

        @if (_isLoading)
        {
            <h1 class="page-title">Загрузка профиля...</h1>
        }
        else if (profile == null)
        {
            <h1 class="page-title">Профиль не найден</h1>
            <p style="color: white; font-size: 20px;">Требуется вход в систему.</p>
        }
        else
        {
            <h1 class="page-title">Ваш профиль</h1>

            <div style="display: grid;
                            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
                            gap: clamp(28px, 4.6vw, 40px);
                            width: 100%;
                            max-width: 1400px;
                            justify-content: center;">

                <div class="glass-card" style="padding: clamp(30px, 4vw, 46px);">
                    <h2 class="card-title">Информация</h2>
                    <div class="info-text">
                        <p><strong>Имя:</strong> @profile.FullName</p>
                        <p><strong>Email:</strong> @profile.Email</p>
                        <p><strong>Телефон:</strong> @profile.PhoneNumber</p>
                    </div>
                    <div style="margin-top: 30px; display: flex;">
                        <button @onclick="Logout" class="btn-outline" style="width: 100%;">Выйти</button>
                    </div>
                </div>

                <div class="glass-card" style="padding: clamp(30px, 4vw, 46px);">
                    <h2 class="card-title">История бронирований</h2>
                    @if (profile.Bookings.Any())
                    {
                        <ul class="custom-list">
                            @foreach (var b in profile.Bookings)
                            {
                                <li>
                                    <span>@b.RoomName</span>
                                    <span>@b.StartTime.ToShortDateString() — <strong style="color: #e0c070;">@b.TotalPrice ₽</strong></span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="empty-text">Пока нет бронирований</p>
                    }
                </div>

            </div>
        }
    </div>
</div>

<style>
    .page-container {
        position: relative;
    }

    .hover-dark-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.93));
        z-index: 3.5;
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
    }

    .page-container:hover .hover-dark-overlay {
        opacity: 1;
    }

    .page-title {
        color: #ffffff;
        font-size: clamp(39px, 7.1vw, 84px);
        font-weight: 900;
        letter-spacing: clamp(-3px, -0.6vw, -5.5px);
        text-shadow: 0 18px 55px rgba(0,0,0,0.9);
        margin-bottom: clamp(32px, 5.8vh, 68px);
        text-align: center;
    }

    .card-title {
        color: white;
        font-size: clamp(24px, 3.5vw, 32px);
        font-weight: 800;
        margin: 0 0 24px;
        border-bottom: 1px solid rgba(255,255,255,0.2);
        padding-bottom: 12px;
    }

    .glass-card {
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(24px);
        border-radius: clamp(26px, 3.4vw, 42px);
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 35px 90px rgba(0,0,0,0.75);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .glass-card:hover {
            transform: translateY(-12px);
            border-color: #e0c070;
            box-shadow: 0 45px 100px rgba(224,192,112,0.35);
        }

    .info-text p {
        color: rgba(255,255,255,0.95);
        line-height: 1.8;
        margin-bottom: 12px;
        font-size: clamp(16px, 2.4vw, 19px);
    }

    .empty-text {
        color: rgba(255,255,255,0.7);
        font-size: 18px;
        font-style: italic;
    }

    .custom-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

        .custom-list li {
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 17px;
            background: rgba(0,0,0,0.2);
            padding: 16px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.1);
        }

    .btn-outline {
        min-width: 150px;
        padding: clamp(16px, 2.8vw, 25px);
        font-size: clamp(17px, 2.8vw, 22.5px);
        font-weight: 600;
        background: transparent;
        color: white;
        border: clamp(3px, 0.4vw, 4.5px) solid white;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background: rgba(255,255,255,0.12);
            border-color: #e0c070;
            color: #e0c070;
            transform: translateY(-2px);
        }
</style>

@code {
    private ProfileDto? profile;
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1);
            await LoadProfile();
            StateHasChanged();
        }
    }

    private async Task LoadProfile()
    {
        Console.WriteLine("LoadProfile started");
        var token = await AuthService.GetTokenAsync();
        Console.WriteLine($"Token retrieved: {(token != null ? token.Substring(0, Math.Min(10, token.Length)) + "..." : "null")}");

        if (string.IsNullOrEmpty(token))
        {
            Console.WriteLine("Token missing or empty, redirecting to login");
            NavigationManager.NavigateTo("/login");
            return;
        }

        var resp = await ProfileApiClient.GetProfileAsync(token);
        Console.WriteLine($"Profile API response status: {(int)resp.StatusCode}");

        if (resp.IsSuccessStatusCode)
        {
            profile = await resp.Content.ReadFromJsonAsync<ProfileDto>();
            Console.WriteLine("Profile loaded successfully");
        }
        else
        {
            var errorBody = await resp.Content.ReadAsStringAsync();
            Console.WriteLine($"Profile API failed. Status: {resp.StatusCode}, Body: {errorBody}");
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login");
        }
        _isLoading = false;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }
}
