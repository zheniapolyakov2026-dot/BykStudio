@page "/rooms"
@layout FullScreenLayout
@using BykStudio.data.Models
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="relative min-h-screen overflow-hidden">
    <!-- Full-bleed background (exact MAUI style) -->
    <img src="/images/room7.jpg"
         class="absolute inset-0 w-full h-full object-cover"
         alt="Studio" />

    <!-- Subtle dark gradient overlay (makes text & cards pop) -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/60"></div>

    <!-- Content -->
    <div class="relative z-10 pt-24 pb-20 min-h-screen">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-white text-5xl font-bold text-center mb-12 drop-shadow-2xl tracking-tight">
                Наши комнаты
            </h2>

            <!-- Horizontal scrollable cards -->
            <div class="flex gap-8 overflow-x-auto pb-12 snap-x snap-mandatory scrollbar-hide">
                @foreach (var room in RoomList)
                {
                    <div class="min-w-[480px] snap-center">
                        <RoomCard Room="room"
                                  OnViewPhotos="() => OpenGallery(room)"
                                  OnBook="() => BookRoom(room)" />
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Gallery Modal -->
    @if (ShowGallery)
    {
        <PhotoGallery Photos="CurrentPhotos" OnClose="CloseGallery" />
    }
</div>

@code {
    private List<Room> RoomList { get; set; } = new();

    private bool ShowGallery = false;
    private List<string> CurrentPhotos = new();

    protected override void OnInitialized()
    {
        RoomList = new List<Room>
        {
            new Room {
                Name = "комната 1",
                PricePerHour = 2000,
                Description = "описание.",
                MainImageUrl = "/images/room1.jpg",
                Photos = new List<string> { "/images/room1.jpg", "/images/room2.jpg", "/images/room3.jpg", "/images/room4.jpg" }
            },
            new Room {
                Name = "комната 2",
                PricePerHour = 2000,
                Description = "описание.",
                MainImageUrl = "/images/room2.jpg",
                Photos = new List<string> { "/images/room7.jpg", "/images/room5.jpg", "/images/room6.jpg" }
            }
        };
    }

    private void OpenGallery(Room room)
    {
        CurrentPhotos = room.Photos;
        ShowGallery = true;
    }

    private void CloseGallery() => ShowGallery = false;

    private async Task BookRoom(Room room)
    {
        await JS.InvokeVoidAsync("alert", $"Вы выбрали {room.Name}");
    }
}