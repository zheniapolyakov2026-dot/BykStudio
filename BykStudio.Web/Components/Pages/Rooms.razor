@page "/rooms"
@layout FullScreenLayout
@rendermode InteractiveServer
@using BykStudio.data.Models
@using BykStudio.Web.Services
@inject IJSRuntime JS
@inject RoomService RoomService
@inject NavigationManager NavigationManager

<div class="page-container" style="position: relative; height: 100vh; width: 100%; overflow: hidden;">

    <!-- Фон -->
    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio" />

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.07; z-index: 2;"></div>

    <!-- Очень сильное затемнение фона -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.18), rgba(0,0,0,0.65));
                z-index: 3;"></div>

    <div class="hover-dark-overlay"></div>

    <div style="position: relative; z-index: 4; height: 100vh;
                display: flex; flex-direction: column; justify-content: center; align-items: center;
                padding: 0 20px;">

        <h1 style="color: #ffffff;
                   font-size: clamp(39px, 7.1vw, 84px);
                   font-weight: 900;
                   letter-spacing: clamp(-3px, -0.6vw, -5.5px);
                   text-shadow: 0 18px 55px rgba(0,0,0,0.9);
                   margin-bottom: clamp(32px, 5.8vh, 68px);">
            Наши залы
        </h1>

        <!-- Карточки: теперь компактные + строго ограниченная ширина -->
        <div style="display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(380px, 515px));
                    gap: clamp(28px, 4.6vw, 78px);
                    width: 100%;
                    max-width: 1700px;
                    justify-content: center;">

            @foreach (var room in RoomList)
            {
                <div class="glass-card">
                    <img src="@room.MainImageUrl"
                         style="width: 100%; height: clamp(245px, 31.5vh, 415px); object-fit: cover;"
                         alt="@room.Name" />

                    <div style="padding: clamp(30px, 4vw, 46px) clamp(26px, 3.6vw, 46px) clamp(36px, 4.5vw, 50px);">
                        <h2 style="color: white; font-size: clamp(28px, 4.7vw, 41px); font-weight: 800; margin: 0 0 12px;">
                            @room.Name
                        </h2>
                        <p style="color: rgba(255,255,255,0.95);
                                      line-height: 1.6;
                                      margin-bottom: 24px;
                                      font-size: clamp(15.5px, 2.4vw, 18.5px);">
                            @room.Description
                        </p>
                        <div style="display: flex; gap: clamp(16px, 2.8vw, 28px); flex-wrap: wrap;">
                            <button @onclick="() => OpenGallery(room)" class="btn-outline">Просмотреть</button>
                            <button @onclick="() => GoToCalendar(room)" class="btn-primary">Забронировать</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (ShowGallery)
    {
        <PhotoGallery Photos="CurrentPhotos" OnClose="CloseGallery" />
    }
</div>

<style>
    .page-container {
        position: relative;
    }

    .hover-dark-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.93));
        z-index: 3.5;
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
    }

    .page-container:hover .hover-dark-overlay {
        opacity: 1;
    }

    .glass-card {
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(24px);
        border-radius: clamp(26px, 3.4vw, 42px);
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 35px 90px rgba(0,0,0,0.75);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .glass-card:hover {
            transform: translateY(-12px);
            border-color: #e0c070;
            box-shadow: 0 45px 100px rgba(224,192,112,0.35);
        }

    .btn-outline {
        flex: 1;
        min-width: 150px;
        padding: clamp(16px, 2.8vw, 25px);
        font-size: clamp(17px, 2.8vw, 22.5px);
        font-weight: 600;
        background: transparent;
        color: white;
        border: clamp(3px, 0.4vw, 4.5px) solid white;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background: rgba(255,255,255,0.12);
            border-color: #e0c070;
            color: #e0c070;
            transform: translateY(-2px);
        }

    .btn-primary {
        flex: 1;
        min-width: 150px;
        padding: clamp(16px, 2.8vw, 25px);
        font-size: clamp(17px, 2.8vw, 22.5px);
        font-weight: 700;
        background: white;
        color: #111;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        }
</style>

@code {
    private List<Room> RoomList { get; set; } = new();
    private bool ShowGallery = false;
    private List<string> CurrentPhotos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Assuming RoomService has method like this
            RoomList = await RoomService.GetAllRoomsAsync() ?? new List<Room>();
        }
        catch (Exception ex)
        {
            // For debugging
            Console.WriteLine(ex.ToString());
            // or show notification with Radzen
        }
    }

    private void GoToCalendar(Room room)
    {
        NavigationManager.NavigateTo($"/calendar/{Uri.EscapeDataString(room.Name)}");
    }

    private void OpenGallery(Room room) { CurrentPhotos = room.Photos; ShowGallery = true; }
    private void CloseGallery() => ShowGallery = false;
    private async Task BookRoom(Room room) => await JS.InvokeVoidAsync("alert", $"Выбрана: {room.Name}");
}