@page "/rooms"
@layout FullScreenLayout
@rendermode InteractiveServer
@using BykStudio.data.Models
@inject IJSRuntime JS

<div style="position: relative; height: 100vh; width: 100%; overflow: hidden;">

    <!-- Фон -->
    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio" />

    <!-- Белый оверлей -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.2; z-index: 2;"></div>

    <!-- Очень сильное затемнение фона -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.95));
                z-index: 3;"></div>

    <!-- Основной контент — строго по центру -->
    <div style="position: relative; z-index: 4; height: 100vh;
                display: flex; flex-direction: column; justify-content: center; align-items: center;
                padding: 0 40px;">

        <h1 style="color: #ffffff; font-size: clamp(65px, 9.5vw, 115px); font-weight: 900;
                   letter-spacing: -6px; text-shadow: 0 20px 65px rgba(0,0,0,0.9); margin-bottom: 100px;">
            Наши комнаты
        </h1>

        <!-- Карточки: ещё больше, по центру, большое расстояние -->
        <div style="display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(800px, 1fr));
                    gap: 200px;
                    width: 100%;
                    max-width: 1800px;
                    justify-content: center;">

            @foreach (var room in RoomList)
            {
                <div style="background: rgba(255,255,255,0.16); backdrop-filter: blur(24px);
                                border-radius: 48px; overflow: hidden;
                                border: 2px solid rgba(255,255,255,0.55);
                                box-shadow: 0 50px 120px rgba(0,0,0,0.75);">

                    <img src="/images/room7.jpg"
                         style="width: 100%; height: 700px; object-fit: cover;"
                         alt="@room.Name" />

                    <div style="padding: 60px 55px 55px;">
                        <h2 style="color: white; font-size: 48px; font-weight: 800; margin: 0 0 14px;">@room.Name</h2>
                        <p style="color: #ffd700; font-size: 35px; font-weight: 700; margin: 0 0 36px;">
                            @room.PricePerHour ₽ / час
                        </p>
                        <p style="color: rgba(255,255,255,0.95); line-height: 1.65; margin-bottom: 55px; font-size: 20px;">
                            @room.Description
                        </p>

                        <div style="display: flex; gap: 32px;">
                            <button @onclick="() => OpenGallery(room)"
                                    style="flex: 1; padding: 30px; font-size: 25px; font-weight: 600;
                                               background: transparent; color: white; border: 5px solid white;
                                               border-radius: 50px; cursor: pointer;">
                                Просмотреть
                            </button>
                            <button @onclick="() => BookRoom(room)"
                                    style="flex: 1; padding: 30px; font-size: 25px; font-weight: 700;
                                               background: white; color: #111; border: none;
                                               border-radius: 50px; cursor: pointer;">
                                Забронировать
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (ShowGallery)
    {
        <PhotoGallery Photos="CurrentPhotos" OnClose="CloseGallery" />
    }
</div>

@code {
    private List<Room> RoomList { get; set; } = new();

    private bool ShowGallery = false;
    private List<string> CurrentPhotos = new();

    protected override void OnInitialized()
    {
        RoomList = new List<Room>
        {
            new Room { Name = "Комната 1", PricePerHour = 2500, Description = "Просторная светлая студия с большими окнами и современным минимализмом.", MainImageUrl = "/images/room7.jpg", Photos = new List<string> { "/images/room7.jpg" } },
            new Room { Name = "Комната 2", PricePerHour = 2800, Description = "Уютная комната с тёплым светом и винтажной атмосферой.", MainImageUrl = "/images/room7.jpg", Photos = new List<string> { "/images/room7.jpg" } }
        };
    }

    private void OpenGallery(Room room) { CurrentPhotos = room.Photos; ShowGallery = true; }
    private void CloseGallery() => ShowGallery = false;
    private async Task BookRoom(Room room) => await JS.InvokeVoidAsync("alert", $"Выбрана: {room.Name}");
}