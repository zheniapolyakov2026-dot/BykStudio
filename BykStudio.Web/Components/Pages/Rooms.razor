@page "/rooms"
@layout FullScreenLayout
@rendermode InteractiveServer
@using BykStudio.data.Models
@inject IJSRuntime JS

<div style="position: relative; height: 100vh; width: 100%; overflow: hidden;">

    <!-- Фон -->
    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio" />

    <!-- Белый оверлей -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.2; z-index: 2;"></div>

    <!-- Очень сильное затемнение фона -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.95));
                z-index: 3;"></div>

    <!-- Основной контент — строго по центру -->
    <div style="position: relative; z-index: 4; height: 100vh;
                display: flex; flex-direction: column; justify-content: center; align-items: center;
                padding: 0 20px;">

        <h1 style="color: #ffffff;
                   font-size: clamp(42px, 7.8vw, 98px);
                   font-weight: 900;
                   letter-spacing: clamp(-3px, -0.65vw, -6px);
                   text-shadow: 0 18px 55px rgba(0,0,0,0.9);
                   margin-bottom: clamp(50px, 9vh, 100px);">
            Наши залы
        </h1>

        <!-- Карточки: полностью responsive -->
        <div style="display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
                    gap: clamp(40px, 7vw, 160px);
                    width: 100%;
                    max-width: 1800px;
                    justify-content: center;">

            @foreach (var room in RoomList)
            {
                <div style="background: rgba(255,255,255,0.16); backdrop-filter: blur(24px);
                            border-radius: clamp(32px, 4vw, 48px); overflow: hidden;
                            border: 2px solid rgba(255,255,255,0.55);
                            box-shadow: 0 40px 100px rgba(0,0,0,0.75);">

                    <img src="/images/room7.jpg"
                         style="width: 100%; 
                                height: clamp(340px, 42vh, 620px); 
                                object-fit: cover;"
                         alt="@room.Name" />

                    <div style="padding: clamp(38px, 5.5vw, 60px) clamp(32px, 4.5vw, 55px) clamp(42px, 5.5vw, 55px);">
                        <h2 style="color: white; 
                                   font-size: clamp(32px, 5.6vw, 48px); 
                                   font-weight: 800; 
                                   margin: 0 0 12px;">
                            @room.Name
                        </h2>
                        <p style="color: #ffd700; 
                                  font-size: clamp(24px, 4.2vw, 35px); 
                                  font-weight: 700; 
                                  margin: 0 0 32px;">
                            @room.PricePerHour ₽ / час
                        </p>
                        <p style="color: rgba(255,255,255,0.95); 
                                  line-height: 1.62; 
                                  margin-bottom: clamp(40px, 5vh, 55px); 
                                  font-size: clamp(17px, 2.7vw, 20px);">
                            @room.Description
                        </p>

                        <div style="display: flex; gap: clamp(18px, 3vw, 32px); flex-wrap: wrap;">
                            <button @onclick="() => OpenGallery(room)"
                                    style="flex: 1; 
                                           min-width: 140px;
                                           padding: clamp(18px, 3.2vw, 30px); 
                                           font-size: clamp(18.5px, 3.1vw, 25px); 
                                           font-weight: 600;
                                           background: transparent; 
                                           color: white; 
                                           border: clamp(3.5px, 0.45vw, 5px) solid white;
                                           border-radius: 50px; 
                                           cursor: pointer;">
                                Просмотреть
                            </button>
                            <button @onclick="() => BookRoom(room)"
                                    style="flex: 1; 
                                           min-width: 140px;
                                           padding: clamp(18px, 3.2vw, 30px); 
                                           font-size: clamp(18.5px, 3.1vw, 25px); 
                                           font-weight: 700;
                                           background: white; 
                                           color: #111; 
                                           border: none;
                                           border-radius: 50px; 
                                           cursor: pointer;">
                                Забронировать
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (ShowGallery)
    {
        <PhotoGallery Photos="CurrentPhotos" OnClose="CloseGallery" />
    }
</div>

@code {
    private List<Room> RoomList { get; set; } = new();

    private bool ShowGallery = false;
    private List<string> CurrentPhotos = new();

    protected override void OnInitialized()
    {
        RoomList = new List<Room>
        {
            new Room { Name = "Зал 1", PricePerHour = 2500, Description = "Просторная светлая студия с большими окнами и современным минимализмом.", MainImageUrl = "/images/room7.jpg", Photos = new List<string> { "/images/room7.jpg" } },
            new Room { Name = "Зал 2", PricePerHour = 2800, Description = "Уютная комната с тёплым светом и винтажной атмосферой.", MainImageUrl = "/images/room7.jpg", Photos = new List<string> { "/images/room7.jpg" } }
        };
    }

    private void OpenGallery(Room room) { CurrentPhotos = room.Photos; ShowGallery = true; }
    private void CloseGallery() => ShowGallery = false;
    private async Task BookRoom(Room room) => await JS.InvokeVoidAsync("alert", $"Выбрана: {room.Name}");
}