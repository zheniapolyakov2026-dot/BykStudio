@page "/booking/confirm/{BookingId}"
@layout FullScreenLayout
@rendermode InteractiveServer
@using BykStudio.data.DTOs
@using BykStudio.Web.Services
@inject NavigationManager NavigationManager
@inject BookingService BookingService
@inject IJSRuntime JS

<div style="position: relative; height: 100vh; width: 100%; overflow: hidden;">
    <img src="/images/room7.jpg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;" />
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.2; z-index: 2;"></div>
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.95)); z-index: 3;"></div>

    <div style="position: relative; z-index: 4; height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; overflow-y: auto;">
        <div style="width: 100%; max-width: 800px;">
            <button @onclick="GoBack" style="position: absolute; top: 30px; left: 30px; background: transparent; border: none; color: #fff; font-size: 28px; cursor: pointer; z-index: 10;">← Назад</button>

            <div class="glass-card" style="padding: 40px 35px;">
                <h2 style="color: #fff; margin-bottom: 20px;">Подтвердите данные</h2>

                @if (booking == null)
                {
                    <p style="color: #fff;">Загрузка...</p>
                }
                else
                {
                    <div class="booking-details">
                        <h3 style="color: #e0c070;">ИНТЕРЬЕРНАЯ ФОТОСТУДИЯ<br />Byk_studio</h3>
                        <p><strong>АРЕНДА</strong><br />@booking.StartTime.ToLocalTime().ToString("dd MMMM HH:mm") - @booking.EndTime.ToLocalTime().ToString("HH:mm")<br />@booking.RoomName</p>
                        <p><strong>Количество человек:</strong> @booking.NumberOfPeople</p>
                    </div>

                    <div class="form-group">
                        <label>КОММЕНТАРИЙ</label>
                        <textarea @bind="comment" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group">
                        <label>КАК С ВАМИ СВЯЗАТЬСЯ?</label>
                        <input type="text" @bind="guestName" placeholder="Фамилия Имя" class="form-control" />
                        <input type="email" @bind="guestEmail" placeholder="Email" class="form-control" />
                        <input type="tel" @bind="guestPhone" placeholder="+7 (____) ___-__-__" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>ССЫЛКИ НА СОЦ. СЕТИ</label>
                        <input type="text" @bind="socialLinks" placeholder="Ник или ID в Телеграмм" class="form-control" />
                    </div>

                    <div class="cost-summary">
                        <p>Стоимость: @booking.TotalPrice.ToString("N0") руб.</p>
                        <p>Итого: @booking.TotalPrice.ToString("N0") руб.</p>
                        <p>Предоплата: @booking.TotalPrice.ToString("N0") руб.<br /><small>в течение 15 минут</small></p>
                    </div>

                    <div class="consent">
                        <label>
                            <input type="checkbox" @bind="agreedToRules" /> Я ознакомлен с правилами студии "Byk_studio" и согласен с ними
                        </label>
                        <label>
                            <input type="checkbox" @bind="agreedToData" /> Я ознакомлен и согласен на обработку персональных данных
                        </label>
                    </div>

                    <div style="display: flex; gap: 20px; margin-top: 30px;">
                        <button @onclick="GoBack" class="btn-outline">Назад</button>
                        <button @onclick="SubmitBooking" class="btn-primary" disabled="@(!agreedToRules || !agreedToData)">Забронировать</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(24px);
        border-radius: 30px;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 35px 90px rgba(0,0,0,0.75);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(0,0,0,0.5);
        color: white;
        margin-top: 5px;
    }

    .cost-summary {
        background: rgba(0,0,0,0.5);
        padding: 15px;
        border-radius: 12px;
        margin: 20px 0;
    }

    .consent label {
        display: block;
        color: #ddd;
        margin: 10px 0;
    }

    .btn-outline {
        padding: 12px 30px;
        border: 2px solid white;
        background: transparent;
        color: white;
        border-radius: 50px;
        cursor: pointer;
    }

    .btn-primary {
        padding: 12px 30px;
        background: white;
        color: black;
        border: none;
        border-radius: 50px;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public string BookingId { get; set; } = string.Empty;

    private BookingConfirmationDto? booking;
    private string comment = "";
    private string guestName = "";
    private string guestEmail = "";
    private string guestPhone = "";
    private string socialLinks = "";
    private bool agreedToRules = false;
    private bool agreedToData = false;

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(BookingId, out var id))
        {
            booking = await BookingService.GetBookingConfirmationAsync(id);
            if (booking != null)
            {
                guestName = booking.GuestName ?? "";
                guestEmail = booking.GuestEmail ?? "";
                guestPhone = booking.GuestPhone ?? "";
            }
        }
        else
        {
            NavigationManager.NavigateTo("/not-found");
        }
    }

    private async Task SubmitBooking()
    {
        if (!agreedToRules || !agreedToData) return;
        if (booking == null) return;

        // If it's a guest booking and contact info is not already filled, save it
        if (booking.IsGuestBooking && (string.IsNullOrEmpty(guestName) || string.IsNullOrEmpty(guestEmail) || string.IsNullOrEmpty(guestPhone)))
        {
            await JS.InvokeVoidAsync("alert", "Пожалуйста, заполните контактные данные");
            return;
        }

        // Save contact info (for guests)
        if (booking.IsGuestBooking)
        {
            var contactRequest = new GuestContactRequest
            {
                Name = guestName,
                Email = guestEmail,
                Phone = guestPhone
            };
            var contactSuccess = await BookingService.AddContactInfoAsync(Guid.Parse(BookingId), contactRequest);
            if (!contactSuccess)
            {
                await JS.InvokeVoidAsync("alert", "Ошибка сохранения контактов");
                return;
            }
        }

        // Initiate payment
        var paymentResult = await BookingService.InitiatePaymentAsync(Guid.Parse(BookingId));
        if (paymentResult?.PaymentUrl != null)
        {
            NavigationManager.NavigateTo(paymentResult.PaymentUrl, forceLoad: true);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Не удалось запустить оплату");
        }
    }

    private void GoBack() => NavigationManager.NavigateTo($"/calendar/{booking?.RoomName}");
}
