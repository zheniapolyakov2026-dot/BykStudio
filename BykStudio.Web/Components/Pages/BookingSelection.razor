@page "/booking-selection"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@layout FullScreenLayout

<div class="page-container" style="position: relative; height: 100vh; width: 100%; overflow: hidden; font-family: 'Segoe UI', sans-serif;">

    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio Background" />

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.07; z-index: 2;"></div>

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.18), rgba(0,0,0,0.65));
                z-index: 3;"></div>

    <div class="hover-dark-overlay"></div>

    <div style="position: relative; z-index: 4; height: 100vh;
                display: flex; flex-direction: column; justify-content: center; align-items: center;
                padding: 0 20px;">

        <h1 style="color: #ffffff;
                   font-size: clamp(35px, 6vw, 70px);
                   font-weight: 900;
                   letter-spacing: -1px;
                   text-shadow: 0 18px 55px rgba(0,0,0,0.9);
                   margin-bottom: clamp(40px, 6vh, 70px);
                   text-align: center;">
            Что забронировать?
        </h1>

        <div style="display: flex; gap: clamp(30px, 5vw, 60px); flex-wrap: wrap; justify-content: center; width: 100%; max-width: 1200px;">

            <div @onclick='() => NavigationManager.NavigateTo("/rooms")' class="glass-card">
                <img src="/images/room7.jpg" alt="Rooms" style="width: 100%; height: clamp(220px, 28vh, 320px); object-fit: cover;" />
                <div style="padding: clamp(25px, 3.5vw, 35px); text-align: center;">
                    <h2 style="color: white; font-size: clamp(26px, 3.5vw, 36px); font-weight: 800; margin: 0 0 10px;">Зал</h2>
                    <p style="color: rgba(255,255,255,0.85); font-size: clamp(15px, 2vw, 18px); margin: 0;">Аренда студийного пространства</p>
                </div>
            </div>

            <div @onclick='() => NavigationManager.NavigateTo("/makeup-booking")' class="glass-card">
                <img src="/images/room7.jpg" alt="Makeup" style="width: 100%; height: clamp(220px, 28vh, 320px); object-fit: cover;" />
                <div style="padding: clamp(25px, 3.5vw, 35px); text-align: center;">
                    <h2 style="color: white; font-size: clamp(26px, 3.5vw, 36px); font-weight: 800; margin: 0 0 10px;">Гримерный стол</h2>
                    <p style="color: rgba(255,255,255,0.85); font-size: clamp(15px, 2vw, 18px); margin: 0;">Рабочее место </p>
                </div>
            </div>

        </div>

        <button @onclick="GoBack" class="back-button" style="margin-top: clamp(40px, 7vh, 80px);">
            Вернуться назад
        </button>
    </div>
</div>

<style>
    .page-container {
        position: relative;
    }

    .hover-dark-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.93));
        z-index: 3.5;
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
    }

    .page-container:hover .hover-dark-overlay {
        opacity: 1;
    }

    .glass-card {
        width: clamp(320px, 42vw, 480px);
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(24px);
        border-radius: clamp(22px, 3vw, 35px);
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 30px 70px rgba(0,0,0,0.65);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .glass-card:hover {
            transform: translateY(-12px);
            border-color: #e0c070;
            box-shadow: 0 40px 90px rgba(224,192,112,0.35);
        }

    .back-button {
        padding: clamp(12px, 2vw, 18px) clamp(30px, 4vw, 50px);
        font-size: clamp(16px, 2vw, 20px);
        font-weight: 600;
        border: 2px solid rgba(255,255,255,0.6);
        color: white;
        border-radius: 50px;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .back-button:hover {
            background: white;
            color: #111;
            border-color: white;
            transform: scale(1.05);
        }
</style>

@code {
    private void GoBack() => NavigationManager.NavigateTo("/");
}