@page "/makeup-calendar"
@layout FullScreenLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject MakeupBookingService MakeupBookingService
@inject MakeupTableService MakeupTableService
@inject IJSRuntime JS
@using BykStudio.Web.Services
@using BykStudio.data.DTOs
@using System.Globalization
@using Radzen
@using Radzen.Blazor

<style>
    .booking-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        padding: 20px;
        background-color: #ffffff; /* */
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        max-width: 900px;
        margin: 0 auto;
        font-family: sans-serif;
    }

    .calendar-section {
        flex: 1;
        min-width: 300px;
    }

    .time-section {
        flex: 1;
        min-width: 300px;
    }

    .time-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .time-slot {
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #dee2e6; /* */
        background-color: #ffffff; /* */
        cursor: pointer;
        text-align: center;
        transition: all 0.2s ease;
        font-weight: bold;
    }

        .time-slot:hover:not(:disabled) {
            border-color: #007bff;
            color: #007bff;
        }

        .time-slot.booked {
            background-color: #ff6b6b; /* */
            color: white;
            border-color: #ff6b6b;
            cursor: not-allowed;
            opacity: 0.7;
        }

        .time-slot.past {
            background-color: #e9ecef; /* */
            color: #adb5bd;
            cursor: not-allowed;
            border-color: #e9ecef;
        }

        .time-slot.selected {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

        .time-slot.selected-interval {
            background-color: #90ee90; /* light green */
            border-color: #2e8b57;
            color: #2c3e50;
        }

    h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #333;
    }
</style>

<!-- Кинематографичный фон (точно как на Home и Rooms) -->
<div style="position: relative; height: 100vh; width: 100%; overflow: hidden;">
    <img src="/images/room7.jpg"
         style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
         alt="Studio" />

    <!-- Белый оверлей -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: white; opacity: 0.2; z-index: 2;"></div>

    <!-- Затемнение фона -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.95));
                z-index: 3;"></div>

    <!-- Контент -->
    <div style="position: relative; z-index: 4; height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
        <div style="width: 100%; max-width: 960px;">
            <!-- Кнопка назад -->
            <button @onclick="GoBack"
                    style="position: absolute; top: 30px; left: 30px; background: transparent; border: none; color: #fff; font-size: 28px; cursor: pointer; z-index: 10;">
                ← Назад
            </button>

            <h1 style="color: #ffffff; text-align: center; font-size: 42px; margin-bottom: 30px;">
                Бронирование гримерного стола
            </h1>

            <!-- ВАШ ТОЧНЫЙ КАЛЕНДАРЬ (ничего не изменено) -->
            <div class="booking-wrapper">
                <div class="calendar-section">
                    <h3>📅 Выберите день</h3>
                    <RadzenDatePicker TValue="DateTime?"
                                      Inline="true"
                                      Value="selectedDate"
                                      Change="@OnDateSelected"
                                      DateRender="@OnDateRender"
                                      Culture="@(new CultureInfo("ru-RU"))" />
                </div>

                <div class="time-section">
                    @if (selectedDate.HasValue)
                    {
                        <h3>⏰ Доступное время на @selectedDate.Value.ToString("dd MMMM", new CultureInfo("ru-RU"))</h3>

                        <div class="time-grid">
                            @foreach (var utcTime in GetTimeSlotsForDate(selectedDate.Value))
                            {
                                var localTime = utcTime.ToLocalTime();   // show local time
                                bool isPast = utcTime < DateTime.UtcNow;
                                bool isStartTimeFree = IsSlotAvailable(utcTime);
                                bool isSelected = selectedStartTimeUtc == utcTime;
                                bool isInSelectedInterval = selectedStartTimeUtc.HasValue &&
                                                            utcTime >= selectedStartTimeUtc.Value &&
                                                            utcTime < selectedStartTimeUtc.Value.AddHours(selectedDuration);

                                <button class="time-slot @(isStartTimeFree ? "" : "booked")
                                                        @(isPast ? "past" : "")
                                                        @(isSelected ? "selected" : "")
                                                        @(isInSelectedInterval ? "selected-interval" : "")"
                                        disabled="@(!isStartTimeFree || isPast)"
                                        @onclick="() => OnTimeSelected(utcTime)">
                                    @localTime.ToString("HH:mm")
                                </button>
                            }
                        </div>

                        @if (selectedStartTimeUtc.HasValue)
                        {
                            var localStart = selectedStartTimeUtc.Value.ToLocalTime();
                            <div style="margin-top: 20px; padding: 15px; background: #e3f2fd; border-radius: 8px;">
                                <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
                                    <div>
                                        <label>Продолжительность:</label>
                                        <select @bind="selectedDuration">
                                            @for (int i = 1; i <= MaxAvailableHours; i++)
                                            {
                                                <option value="@i">@i час@(i > 1 ? "а" : "")</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <strong>Цена:</strong> @TotalPrice ₽
                                    </div>
                                </div>
                                <div style="margin-top: 10px;">
                                    <strong>Выбрано:</strong> @localStart.ToString("dd MMMM в HH:mm", new CultureInfo("ru-RU"))
                                    (@selectedDuration часа)
                                </div>
                                <RadzenButton Text="Подтвердить бронь"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Class="mt-3"
                                              Click="@ConfirmBooking"
                                              Disabled="@(!IsIntervalFree(selectedStartTimeUtc.Value, selectedDuration))" />
                            </div>
                        }
                    }
                    else
                    {
                        <div style="color: #6c757d; margin-top: 20px;">
                            👈 Пожалуйста, выберите дату в календаре слева, чтобы увидеть свободные часы.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private MakeupTableDto? _makeupTable;       // store full table data
    private DateTime? selectedDate = DateTime.Today;
    private DateTime? selectedStartTimeUtc = null;
    private int selectedDuration = 1;            // default 1 hour
    private List<BookedSlotDto> _bookedSlots = new();

    // Computed total price
    private decimal TotalPrice => (selectedDuration * (_makeupTable?.PricePerHour ?? 0));

    // Maximum hours available from the selected start time (based on bookings and closing time)
    private int MaxAvailableHours => selectedStartTimeUtc.HasValue
        ? GetMaxAvailableHours(selectedStartTimeUtc.Value)
        : 1;

    protected override async Task OnInitializedAsync()
    {
        _makeupTable = await MakeupTableService.GetMakeupTableAsync();
        if (_makeupTable == null)
        {
            NavigationManager.NavigateTo("/not-found");
            return;
        }

        await LoadBookedSlotsForDate(selectedDate!.Value);
    }

    private async Task LoadBookedSlotsForDate(DateTime date)
    {
        // Convert the local date to UTC start and end (the exact UTC day)
        var startUtc = date.Date.ToUniversalTime();
        var endUtc = startUtc.AddDays(1);
        _bookedSlots = await MakeupBookingService.GetBookedSlotsAsync(startUtc, endUtc);
    }

    private async Task OnDateSelected(DateTime? date)
    {
        selectedDate = date;
        selectedStartTimeUtc = null;
        if (date.HasValue)
        {
            await LoadBookedSlotsForDate(date.Value);
            StateHasChanged();
        }
    }

    // Called when start time is clicked
    private void OnTimeSelected(DateTime utcTime)
    {
        selectedStartTimeUtc = utcTime;
        // Cap the selected duration to the maximum available from this start time
        var maxAvailable = MaxAvailableHours;
        if (selectedDuration > maxAvailable) selectedDuration = maxAvailable;
        StateHasChanged();
    }

    // Returns the maximum number of hours we can book from startUtc without overlapping any booking,
    // and not exceeding the closing time (21:00 local).
    private int GetMaxAvailableHours(DateTime startUtc)
    {
        // If the start time itself is not free, return 0
        if (!IsSlotAvailable(startUtc)) return 0;

        var startLocal = startUtc.ToLocalTime();
        var closingLocal = startLocal.Date.AddHours(21); // business closes at 21:00 local
        if (startLocal >= closingLocal) return 0;

        var maxClosingHours = (int)((closingLocal - startLocal).TotalHours);
        if (maxClosingHours <= 0) return 0;

        // Find the next booking that starts after startUtc (because startUtc itself is free)
        var nextBooking = _bookedSlots
            .Where(slot => slot.StartTime > startUtc)
            .OrderBy(slot => slot.StartTime)
            .FirstOrDefault();

        if (nextBooking != null)
        {
            var hoursToNextBooking = (int)((nextBooking.StartTime - startUtc).TotalHours);
            return Math.Min(maxClosingHours, hoursToNextBooking);
        }

        return maxClosingHours;
    }

    // Check if the interval (UTC start + duration) overlaps any existing booking (UTC)
    private bool IsIntervalFree(DateTime startUtc, int hours)
    {
        var endUtc = startUtc.AddHours(hours);
        return !_bookedSlots.Any(slot =>
            startUtc < slot.EndTime && endUtc > slot.StartTime);
    }

    // Checks if a time slot can be used as a start time (i.e., at least 1 hour is available).
    private bool IsSlotAvailable(DateTime utcTime)
    {
        return IsIntervalFree(utcTime, 1);
    }

    // Confirm booking with chosen start and duration
    private async Task ConfirmBooking()
    {
        if (!selectedStartTimeUtc.HasValue || _makeupTable == null) return;

        var start = selectedStartTimeUtc.Value;
        var end = start.AddHours(selectedDuration);

        // Double-check (though UI already disables button)
        if (!IsIntervalFree(start, selectedDuration))
        {
            await JS.InvokeVoidAsync("alert", "Выбранное время уже занято");
            return;
        }

        var request = new CreateMakeupBookingRequest
        {
            MakeupTableId = _makeupTable.MakeupTableId,
            StartTime = start,
            EndTime = end
        };

        var (success, result, error) = await MakeupBookingService.CreateMakeupBookingAsync(request);
        if (!success || result == null || result.BookingId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", $"Не удалось создать бронь: {error}");
            return;
        }

        NavigationManager.NavigateTo($"/makeup-booking/confirm/{result.BookingId}");
    }

    void OnDateRender(DateRenderEventArgs args)
    {
        if (args.Date.Date < DateTime.Today) args.Disabled = true;
    }

    List<DateTime> GetTimeSlotsForDate(DateTime date)
    {
        var slots = new List<DateTime>();
        var startTimeLocal = date.Date.AddHours(8);
        var endTimeLocal = date.Date.AddHours(21);
        while (startTimeLocal < endTimeLocal)
        {
            // Convert local slot to UTC
            var utcSlot = DateTime.SpecifyKind(startTimeLocal, DateTimeKind.Local).ToUniversalTime();
            slots.Add(utcSlot);
            startTimeLocal = startTimeLocal.AddHours(1);
        }
        return slots;
    }

    private void GoBack() => NavigationManager.NavigateTo("/makeup-booking");
}