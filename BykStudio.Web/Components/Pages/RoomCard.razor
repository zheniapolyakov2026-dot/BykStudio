@using BykStudio.data.Models

<div class="room-card">
    <img src="@Room.MainImageUrl" class="room-image" alt="@Room.Name" />

    <div class="room-info">
        <h3>@Room.Name</h3>
        <p class="price">@Room.PricePerHour ₽/час</p>
        <p class="description">@Room.Description</p>
    </div>

    <div class="room-actions">
        <button class="btn-view" @onclick="ViewPhotos">просмотр</button>
        <button class="btn-book" @onclick="Book">забронировать</button>
    </div>
</div>

@code {
    [Parameter] public Room Room { get; set; } = default!;

    [Parameter] public EventCallback<Room> OnViewPhotos { get; set; }
    [Parameter] public EventCallback<Room> OnBook { get; set; }

    private void ViewPhotos() => OnViewPhotos.InvokeAsync(Room);
    private void Book() => OnBook.InvokeAsync(Room);
}