<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:BykStudio"
       xmlns:view="clr-namespace:BykStudio.View"
       x:Class="BykStudio.AppShell">

    <!-- Регистрируем главную страницу как стартовую -->
    <ShellContent Title="Главная" Route="main" ContentTemplate="{DataTemplate local:MainPage}" />

    <!-- Регистрируем страницу комнат по маршруту "rooms" -->
    <ShellContent Route="rooms" ContentTemplate="{DataTemplate view:RoomsPage}" />

</Shell>